@{
    ViewData["Title"] = "Home";
}

<section class="hero">

    <div class="hero-text">
        <h1>Live Healthy,<br><span>Feel Better.</span></h1>

        <p>
            Track your health, discover healthy recipes,
            and become the best version of yourself.
        </p>

       
    </div>

    <div class="hero-image">
        <img src="https://png.pngtree.com/png-vector/20241025/ourmid/pngtree-healthy-food-cartoon-design-png-image_14145959.png"
             alt="Healthy food">
    </div>

</section>
<section class="features">

    <a asp-controller="Home"
       asp-action="Watertracker"
       class="feature">

        <div class="feature-icon">💧</div>
        <h3>Water</h3>
        <p>Stay hydrated</p>

    </a>


    <a asp-controller="Home"
       asp-action="Dashboard"
       class="feature">

        <div class="feature-icon">🚶</div>
        <h3>Steps</h3>
        <p>Track your movement</p>

    </a>


    <a asp-controller="Home"
       asp-action="Recipes"
       class="feature">

        <div class="feature-icon">🍎</div>
        <h3>Healthy Food</h3>
        <p>Discover healthy meals</p>

    </a>

</section>