@{
    ViewData["Title"] = "Settings";
}

<div class="settings-page">

    <h1>⚙️ Settings</h1>
    <p>Customize your VitaBloom experience.</p>

    <div class="settings-card">

        <h3>🌱 Account</h3>

        <div class="setting-item">
            <span>Account</span>
            <span>Logged in</span>
        </div>

    </div>

    <div class="settings-card">

        <h3>🔔 Notifications</h3>

        <div class="setting-item">
            <span>Notifications</span>

            <label class="switch">
                <input type="checkbox" checked>
                <span class="slider"></span>
            </label>
        </div>

    </div>

    <div class="settings-card">

        <h3>🌙 Appearance</h3>

        <div class="setting-item">
            <span>Dark Mode</span>

            <label class="switch">
                <input type="checkbox"
                       id="darkMode"
                       onchange="toggleDarkMode()">

                <span class="slider"></span>
            </label>

    </div>

</div>