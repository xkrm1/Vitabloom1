@{
    ViewData["Title"] = "Water Tracker";
}

<div class="water-tracker">
    <h1>💧 Water Tracker</h1>
    <p>Stay hydrated, stay healthy</p>

    <div id="glasses" class="glasses"></div>

    <h2><span id="waterCount">0</span>/8 glasses</h2>
    <p>Today's Goal: 8 glasses</p>

    <button type="button" onclick="addWater()">Add Water</button>

    <p id="waterMessage"></p>
</div>

