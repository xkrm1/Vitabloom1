<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8">

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0">

    <title>@ViewData["Title"] - VitaBloom</title>

    <link rel="stylesheet"
          href="~/css/style.css">

    <script src="~/js/site.js"></script>

</head>

<body>

    <header>

        <nav class="navbar">

            <a asp-controller="Home"
               asp-action="Index"
               class="logo">
                🌿 Vita<span>Bloom</span>
            </a>

           

                <div class="nav-links">
                    <a asp-controller="Home" asp-action="Index">Home</a>
                    <a asp-controller="Home" asp-action="About">About</a>
                    <a asp-controller="Home" asp-action="Contact">Contact</a>
                    <a asp-controller="Home" asp-action="Dashboard">Dashboard</a>


                    
                        <a asp-controller="Home"
                           asp-action="Logout"
                           class="logout-link">
                            Logout
                        </a>
                    
                </div>
            </nav>

        </nav>

    </header>

    <main>

        @RenderBody()

    </main>

    <footer>

        <p>
            © 2026 VitaBloom | Health & Wellness
        </p>

    </footer>

    <script src="~/js/site.js"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>

</html>