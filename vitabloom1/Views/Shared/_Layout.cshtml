<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8">

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0">

    <title>@ViewData["Title"] - VitaBloom</title>

    <link rel="stylesheet"
          href="~/css/style.css">


</head>

<body>

    <header>
        <nav class="navbar">
            @if (User.Identity != null &&
                 User.Identity.IsAuthenticated &&
                 ViewContext.RouteData.Values["action"]?.ToString() != "Login" &&
                 ViewContext.RouteData.Values["action"]?.ToString() != "Register")
            {
                <div class="logo">
                    🌱 VitaBloom
                </div>

                <button type="button"
                        class="menu-button"
                        onclick="toggleMenu()">
                    ☰
                </button>

                <div class="nav-links" id="navLinks">

                    <a asp-controller="Home" asp-action="Index">
                        Home
                    </a>

                    <a asp-controller="Home" asp-action="Dashboard">
                        Dashboard
                    </a>

                    <a asp-controller="Home" asp-action="About">
                        About
                    </a>

                    <a asp-controller="Home" asp-action="Contact">
                        Contact
                    </a>

                    <a asp-controller="Home"
                       asp-action="Logout"
                       class="logout-link">
                        Logout
                    </a>

                </div>
            }

        </nav>
    </header>

    <main>

        @RenderBody()

    </main>

    <footer>

        <p>
            © 2026 VitaBloom | Health & Wellness
        </p>

    </footer>

    <script src="~/js/site.js"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>

</html>